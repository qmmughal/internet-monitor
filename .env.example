# Environment variables used by WiFi Monitor. All are optional.
# Copy the ones you need into your shell profile or service definition.
# Never commit real values.

# Config directory override (default: %APPDATA%\wifi-monitor or ~/.config/wifi-monitor)
# WIFI_MONITOR_HOME=

# AI explanations with ai.provider = "anthropic" (also needs ai.enabled = true in config.json)
# ANTHROPIC_API_KEY=

# Token for `wifi-monitor agent` (created with `wifi-monitor hub token add agents <name>`)
# WIFI_MONITOR_AGENT_TOKEN=

# MQTT broker password (mqtt.password_env)
# WIFI_MONITOR_MQTT_PASSWORD=

# Log HTTP requests of `serve` / `hub` to stderr (never logs tokens)
# WIFI_MONITOR_HTTP_LOG=1
